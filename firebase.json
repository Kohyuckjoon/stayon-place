{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/venue/**",
        "function": {
          "functionId": "venuePreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/venues",
        "function": {
          "functionId": "venuesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/mission-venues/**",
        "function": {
          "functionId": "missionVenueDetailPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/register",
        "function": {
          "functionId": "venueRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/teams",
        "function": {
          "functionId": "teamsPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/team-register",
        "function": {
          "functionId": "teamRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/teams/**",
        "function": {
          "functionId": "teamDetailPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/band-room-register",
        "function": {
          "functionId": "bandRoomRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/band-room/**",
        "function": {
          "functionId": "bandRoomPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/programs",
        "function": {
          "functionId": "programsPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/checklist/new",
        "function": {
          "functionId": "checklistPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/goods-register",
        "function": {
          "functionId": "goodsRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/goods/**",
        "function": {
          "functionId": "goodsDetailPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/goods",
        "function": {
          "functionId": "goodsPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/shirts-register",
        "function": {
          "functionId": "shirtsRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/shirts/**",
        "function": {
          "functionId": "shirtsDetailPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/shirts",
        "function": {
          "functionId": "shirtsPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/vehicle-register",
        "function": {
          "functionId": "vehicleRegisterPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/reviews",
        "function": {
          "functionId": "reviewsPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "dynamicSitemap",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/rss.xml",
        "function": {
          "functionId": "rssFeed",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/about",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/story",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/faq",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/planner",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/budget",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/booking-guide",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/safety",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/notices",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/terms",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/privacy",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/vehicles",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/vehicles/**",
        "function": {
          "functionId": "staticPagesPreview",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
